# DeepSeek API 配置示例 —— 复制为 .env 后填入真实值
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60

# 阿里云百炼 / DashScope（万相文生图）配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_T2I_MODEL=wan2.6-t2i
DASHSCOPE_T2I_SIZE=1280*1280
DASHSCOPE_TIMEOUT_SECONDS=120

# MiniMax（海螺 图生视频）配置
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.cn
MINIMAX_I2V_MODEL=MiniMax-Hailuo-2.3
MINIMAX_I2V_DURATION=6
MINIMAX_I2V_RESOLUTION=1080P
MINIMAX_POLL_INTERVAL_SECONDS=5
MINIMAX_POLL_MAX_SECONDS=300
